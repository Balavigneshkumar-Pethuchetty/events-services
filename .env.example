# events-service environment. Copy to .env (prod stack) or .env.test (test stack).
# Values must match ~/my-society's (same DB, Keycloak, internal key).

EVENTS_PROJECT_NAME=society-events        # this stack's compose project name (must differ from my-society's)
SOCIETY_PROJECT=society               # my-society's COMPOSE_PROJECT_NAME — network/postgres/volumes prefix

ANTHROPIC_API_KEY=
APP_PUBLIC_URL=
AUTH_SERVICE_API_KEY=
AUTH_SERVICE_URL=
CLAUDE_MODEL=
EVENT_DB_PASSWORD=
EVENT_DB_USER=
GMAIL_APP_PASSWORD=
GMAIL_SMTP_USER=
INTERNAL_API_KEY=
KEYCLOAK_PUBLIC_URL=
KEYCLOAK_URL=
MINIO_ROOT_PASSWORD=
MINIO_ROOT_USER=
PAYMENT_DB_PASSWORD=
PAYMENT_DB_USER=
PAYMENT_PROVIDER=
PAYMENT_RECONCILIATION_SECRET_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_SERVICE_ENV=
POSTGRES_DB=
POSTGRES_USER=
RECONCILIATION_SERVICE_BASE_URL=
REDIS_PASSWORD=
REDIS_PORT=
REGISTRATION_DB_PASSWORD=
REGISTRATION_DB_USER=
